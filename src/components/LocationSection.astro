---
import { STORE_INFO } from '../data/store';
---

<section id="location" class="scroll-mt-20 py-12 lg:py-16 bg-[#f5f5f5] border-b border-[#e5e5e5]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Info Box -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <div class="text-xs uppercase font-bold tracking-wider text-[#707072] mb-1">
            Store Location &amp; Directions
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] uppercase">
            FIND OUR STORE AT PALITANA TALETI
          </h2>
          <p class="text-sm text-[#707072] mt-2 leading-relaxed">
            Located directly on the main approach to Shatrunjay Teerth. Yatris can pick up climbing sticks, fresh water, puja articles, almonds, and rice before starting their ascent.
          </p>
        </div>

        <!-- Address Card adhering to DESIGN.md -->
        <div class="bg-white p-6 border border-[#e5e5e5] space-y-4 shadow-sm">
          <div>
            <div class="text-xs font-bold uppercase text-[#707072] tracking-wider">Shop &amp; Proprietor Details</div>
            <div class="text-lg font-bold text-[#111111] mt-1">{STORE_INFO.name}</div>
            <div class="text-sm font-semibold text-[#707072]">{STORE_INFO.gujaratiName}</div>
            <div class="text-sm text-[#111111] mt-2 font-semibold">
              પ્રોપ્રાઇટર: <span class="text-black font-extrabold">{STORE_INFO.ownerName} ({STORE_INFO.ownerGujarati})</span>
            </div>
            <div class="text-sm text-[#111111] mt-1 font-medium">
              {STORE_INFO.address}
            </div>
            <div class="text-xs text-[#707072] mt-1 font-medium">
              {STORE_INFO.gujaratiAddress}
            </div>
          </div>

          <div class="pt-3 border-t border-[#f0f0f0] grid grid-cols-2 gap-3 text-xs">
            <div>
              <span class="text-[#707072] block">GPS Coordinates:</span>
              <span class="font-mono font-bold text-[#111111]">
                {STORE_INFO.coordinates.lat.toFixed(5)}, {STORE_INFO.coordinates.lng.toFixed(5)}
              </span>
            </div>
            <div>
              <span class="text-[#707072] block">Opening Hours:</span>
              <span class="font-bold text-[#007d48]">6:00 AM – 10:00 PM</span>
            </div>
          </div>

          <div class="text-xs text-[#707072] bg-[#f5f5f5] p-3 border-l-2 border-[#111111]">
            <strong>શેત્રુંજય તીર્થ યાત્રાળુઓ માટે ખાસ નોંધ:</strong> વહેલી સવારે શેત્રુંજય ચઢવા નીકળતા યાત્રાળુઓ માટે સવારે ૬:૦૦ વાગ્યાથી વોકિંગ સ્ટીક, ઠંડુ પાણી, બદામ, સાકર અને પૂજા સામગ્રી તૈયાર રાખવામાં આવે છે.
          </div>

          <!-- Direct Phone & WhatsApp buttons -->
          <div class="pt-2 flex flex-col sm:flex-row gap-2">
            <a
              href={`tel:${STORE_INFO.phoneRaw}`}
              class="btn-primary !h-11 !px-5 text-xs flex-1 flex items-center justify-center gap-2 font-bold"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Call: {STORE_INFO.phone}</span>
            </a>

            <a
              href={STORE_INFO.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary !h-11 !px-5 text-xs flex-1 flex items-center justify-center gap-2 font-bold"
            >
              <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span>WhatsApp Store</span>
            </a>
          </div>
        </div>

        <!-- Google Earth Specific Highlight Button as Requested -->
        <div class="bg-black text-white p-5 space-y-3">
          <div class="flex items-center gap-2 text-xs uppercase font-bold text-[#ff7074] tracking-wider">
            <svg class="w-4 h-4 text-[#1151ff]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
            <span>Google Earth 3D Satellite View</span>
          </div>
          <p class="text-xs text-white/80 leading-relaxed">
            Open the exact Palitana Taleti store view and 3D terrain on Google Earth.
          </p>
          <a
            href={STORE_INFO.googleEarthUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 w-full bg-white text-[#111111] hover:bg-[#f0f0f0] font-bold text-xs py-3 px-4 rounded-full transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Open in Google Earth (Palitana Taleti)</span>
          </a>
        </div>
      </div>

      <!-- Right Interactive Map Embed -->
      <div class="lg:col-span-7 bg-white border border-[#e5e5e5] p-2 shadow-sm">
        <div class="relative w-full aspect-[4/3] lg:aspect-[16/11] bg-[#e5e5e5] overflow-hidden">
          <iframe
            title="Krishna General Store Palitana Taleti Map"
            src={STORE_INFO.mapEmbedUrl}
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="p-4 bg-white flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="text-[#707072]">
            Coordinates: <span class="font-mono text-black font-semibold">21.50797243° N, 71.81599481° E</span>
          </div>
          <a
            href={STORE_INFO.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-black hover:underline flex items-center gap-1"
          >
            <span>Get Directions in Google Maps</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
