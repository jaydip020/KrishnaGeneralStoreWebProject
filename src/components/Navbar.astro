---
import { STORE_INFO } from '../data/store';
---

<header class="sticky-nav sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-[#e5e5e5] shadow-xs transition-all">
  <!-- Utility Bar per DESIGN.md: height ~36px, soft-cloud bg, caption-sm -->
  <div class="bg-[#f5f5f5] text-[#111111] border-b border-[#e5e5e5] px-3 sm:px-8 py-1.5 text-xs">
    <div class="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-2">
      <!-- Left: Open Timings & Yatra Note -->
      <div class="flex items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center gap-1.5 font-semibold text-[11px] sm:text-xs">
          <span class="w-2 h-2 rounded-full bg-[#007d48] animate-pulse"></span>
          <span>Open Daily 6:00 AM – 10:00 PM</span>
        </span>
        <span class="hidden md:inline text-[#cacacb]">|</span>
        <span class="hidden md:inline text-[#707072] font-medium">
          સવારની શેત્રુંજય તીર્થ યાત્રા માટે ખાસ વહેલા ૬:૦૦ વાગ્યાથી ખુલ્લું
        </span>
      </div>

      <!-- Right: Taleti Location, Wholesale, & Phone -->
      <div class="flex items-center gap-2 sm:gap-4 text-[11px] sm:text-xs font-medium">
        <a href="#location" class="hover:text-black transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-[#707072]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="hidden xs:inline">Palitana Taleti</span>
        </a>
        <span class="text-[#cacacb]">·</span>
        <a href="#wholesale" class="text-[#d30005] hover:underline font-bold flex items-center gap-1">
          <span>Wholesale Rates</span>
        </a>
        <span class="text-[#cacacb]">·</span>
        <a href={`tel:${STORE_INFO.phoneRaw}`} class="hover:text-black transition-colors font-bold">
          <span>{STORE_INFO.phone}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Nav per DESIGN.md: height ~64px, canvas bg, ink text -->
  <nav class="max-w-[1440px] mx-auto px-3 sm:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-3 sm:gap-4">
    <!-- Brand Logo Emblem + Clean Identity -->
    <a href="#" class="flex items-center gap-2.5 sm:gap-3.5 group flex-shrink-0">
      <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white border border-[#e5e5e5] rounded-full overflow-hidden flex-shrink-0 flex items-center justify-center p-0.5 shadow-sm group-hover:border-black transition-colors">
        <img
          src={STORE_INFO.logoUrl}
          alt="Krishna General Store Emblem"
          class="w-full h-full object-contain"
        />
      </div>
      <div class="leading-tight">
        <div class="font-extrabold text-sm sm:text-lg tracking-tight uppercase group-hover:opacity-80 transition-opacity text-[#111111]">
          Krishna General Store
        </div>
        <div class="text-[10px] sm:text-xs text-[#707072] font-medium flex items-center gap-1">
          <span>&amp; ઉપકરણ ભંડાર</span>
          <span class="text-[#cacacb]">·</span>
          <span class="text-black font-semibold">શેત્રુંજય તીર્થ તળેટી</span>
        </div>
      </div>
    </a>

    <!-- Center Desktop Navigation Links -->
    <div class="hidden lg:flex items-center gap-5 xl:gap-6 text-sm font-semibold tracking-tight text-[#111111]">
      <a href="#catalog" class="hover:text-[#707072] transition-colors py-1">
        All 150 Items
      </a>
      <a href="#catalog" data-filter="yatra" class="category-nav-link hover:text-[#707072] transition-colors py-1">
        Shatrunjay Teerth Yatra Gear
      </a>
      <a href="#catalog" data-filter="pooja" class="category-nav-link hover:text-[#707072] transition-colors py-1">
        Jain Upkaran
      </a>
      <a href="#catalog" data-filter="dryfruits" class="category-nav-link hover:text-[#707072] transition-colors py-1">
        Dry Fruits &amp; Grains
      </a>
      <a href="#wholesale" class="text-[#d30005] hover:text-[#780700] transition-colors py-1 font-bold">
        Wholesale Rates (જથ્થાબંધ)
      </a>
      <a href="#location" class="hover:text-[#707072] transition-colors py-1">
        Store Location
      </a>
    </div>

    <!-- Right Quick Actions: Call & WhatsApp Pill Buttons -->
    <div class="flex items-center gap-1.5 sm:gap-3 flex-shrink-0">
      <a
        href={`tel:${STORE_INFO.phoneRaw}`}
        class="hidden sm:inline-flex items-center gap-2 bg-[#f5f5f5] text-[#111111] text-xs font-bold px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full border border-[#e5e5e5] hover:bg-[#ebebeb] transition-colors"
        title="Call Store"
      >
        <svg class="w-3.5 h-3.5 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="hidden md:inline">Call:</span>
        <span>{STORE_INFO.phone}</span>
      </a>

      <!-- Mobile Call Icon Button (Phone Only) -->
      <a
        href={`tel:${STORE_INFO.phoneRaw}`}
        class="sm:hidden w-9 h-9 rounded-full bg-[#f5f5f5] border border-[#e5e5e5] flex items-center justify-center text-[#111111] hover:bg-neutral-200 transition-colors"
        aria-label="Call Store"
      >
        <svg class="w-4 h-4 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </a>

      <!-- WhatsApp Action Pill -->
      <a
        href={STORE_INFO.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2 bg-[#111111] text-white text-[11px] sm:text-xs font-bold px-3 sm:px-4 py-2 sm:py-2.5 rounded-full hover:bg-neutral-800 transition-colors shadow-sm"
      >
        <svg class="w-3.5 h-3.5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-full hover:bg-[#f5f5f5]"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-nav-drawer" class="hidden lg:hidden border-t border-[#e5e5e5] bg-white px-4 py-4 space-y-3 shadow-xl">
    <div class="text-xs text-[#707072] font-semibold pb-2 border-b border-[#f0f0f0] flex justify-between items-center">
      <span>શેત્રુંજય તીર્થ તળેટી, પાલિતાણા</span>
      <span class="text-[#007d48] font-bold">Open 6:00 AM – 10:00 PM</span>
    </div>
    <div class="grid grid-cols-2 gap-2 text-xs sm:text-sm font-semibold">
      <a href="#catalog" class="mobile-nav-link p-2.5 bg-[#f5f5f5] rounded-lg text-center hover:bg-neutral-200 transition-colors">All 150 Items</a>
      <a href="#wholesale" class="mobile-nav-link p-2.5 bg-[#f5f5f5] text-[#d30005] rounded-lg text-center font-bold hover:bg-neutral-200 transition-colors">Wholesale Bulk</a>
      <a href="#catalog" data-filter="yatra" class="mobile-nav-link p-2.5 bg-[#f5f5f5] rounded-lg text-center hover:bg-neutral-200 transition-colors">Yatra Gear</a>
      <a href="#catalog" data-filter="pooja" class="mobile-nav-link p-2.5 bg-[#f5f5f5] rounded-lg text-center hover:bg-neutral-200 transition-colors">Jain Upkaran</a>
      <a href="#catalog" data-filter="dryfruits" class="mobile-nav-link p-2.5 bg-[#f5f5f5] rounded-lg text-center hover:bg-neutral-200 transition-colors">Dry Fruits</a>
      <a href="#location" class="mobile-nav-link p-2.5 bg-[#f5f5f5] rounded-lg text-center hover:bg-neutral-200 transition-colors">Shop Location</a>
    </div>
    <div class="pt-2 flex flex-col gap-2">
      <a href={`tel:${STORE_INFO.phoneRaw}`} class="btn-secondary w-full text-center font-bold !h-11 text-xs sm:text-sm">
        Call Store: {STORE_INFO.phone}
      </a>
      <a href={STORE_INFO.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-primary w-full text-center font-bold !h-11 text-xs sm:text-sm">
        WhatsApp Order &amp; Inquiry
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
      });
    });
  }
</script>
