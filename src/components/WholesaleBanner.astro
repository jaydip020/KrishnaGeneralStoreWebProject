---
import { STORE_INFO } from '../data/store';
---

<section id="wholesale" class="scroll-mt-20 bg-[#111111] text-white py-12 sm:py-16 lg:py-20 border-y border-[#2b2b2d]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Wholesale Value Proposition -->
      <div class="lg:col-span-7 space-y-4 sm:space-y-5">
        <!-- Trade Badge -->
        <div class="inline-flex items-center gap-2 bg-[#d30005]/20 text-[#ff7074] border border-[#d30005]/40 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#d30005] animate-pulse"></span>
          <span>Special Wholesale Trade Rates (જથ્થાબંધ ભાવ)</span>
        </div>

        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Supplying Shop Owners &amp; Dharamshalas Across Palitana &amp; Gujarat
        </h2>

        <p class="text-white/85 text-sm sm:text-base leading-relaxed">
          દુકાનદારો, ધર્મશાળાઓ, આશ્રમો અને ભોજનશાળાઓ માટે ખાસ હોલસેલ ભાવે સામાન ઉપલબ્ધ.
          Direct mandi trade supplies for <strong>Almonds (Badam)</strong>, <strong>Rice (Chaval)</strong>, <strong>Dry Coconut</strong>, <strong>Pure Ghee</strong>, <strong>Walking sticks in bundles</strong>, <strong>Pooja Agarbatti &amp; Dhoop cartons</strong>, <strong>Bisleri water crates</strong>, and <strong>bulk grocery sacks</strong>.
        </p>

        <!-- Feature Grid (Responsive on Mobile: 1 col on xs, 2 cols on sm+) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="p-3.5 bg-white/5 border border-white/10 rounded-xl flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#007d48]/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-[#1eaa52]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-xs sm:text-sm text-white">Direct Mandi Rates</div>
              <div class="text-[11px] text-white/60">Competitive trade margins</div>
            </div>
          </div>

          <div class="p-3.5 bg-white/5 border border-white/10 rounded-xl flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#007d48]/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-[#1eaa52]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-xs sm:text-sm text-white">Bundle &amp; Crate Ready</div>
              <div class="text-[11px] text-white/60">Sacks, cartons &amp; cases</div>
            </div>
          </div>

          <div class="p-3.5 bg-white/5 border border-white/10 rounded-xl flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#007d48]/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-[#1eaa52]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-xs sm:text-sm text-white">Same-Day Packing</div>
              <div class="text-[11px] text-white/60">Fast dispatch from Taleti</div>
            </div>
          </div>

          <div class="p-3.5 bg-white/5 border border-white/10 rounded-xl flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#007d48]/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-[#1eaa52]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-xs sm:text-sm text-white">Direct Billing</div>
              <div class="text-[11px] text-white/60">Official bills &amp; discount</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Quick Wholesale Action Box (Optimized for Mobile Touch) -->
      <div class="lg:col-span-5 bg-[#1a1a1c] border border-white/15 p-5 sm:p-7 rounded-2xl space-y-4 sm:space-y-5 shadow-2xl">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div>
            <div class="text-[11px] uppercase text-[#9e9ea0] font-bold tracking-wider">Wholesale Desk · પાલિતાણા તળેટી</div>
            <div class="text-lg sm:text-xl font-extrabold text-white mt-0.5">{STORE_INFO.ownerName}</div>
            <div class="text-xs text-[#9e9ea0] font-medium">{STORE_INFO.ownerGujarati} (Proprietor)</div>
          </div>
          <span class="text-[11px] bg-[#007d48] text-white px-2.5 py-1 rounded-full font-bold">Direct Desk</span>
        </div>

        <div class="text-xs sm:text-sm text-white/80 leading-relaxed">
          <p>
            Are you a general store owner, yatra organizer, pedhi, or dharamshala manager? Share your required item list with us on WhatsApp or call Mandeepbhai directly to get quick bulk pricing and a customized quotation.
          </p>
        </div>

        <div class="space-y-3 pt-1">
          <a
            href={STORE_INFO.wholesaleWhatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full btn-primary !bg-[#25D366] !text-black !font-extrabold hover:!bg-[#20b858] flex items-center justify-center gap-2 !h-12 text-xs sm:text-sm shadow-md"
          >
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span class="truncate">WhatsApp Wholesale Enquiry: {STORE_INFO.phone}</span>
          </a>

          <a
            href={`tel:${STORE_INFO.phoneRaw}`}
            class="w-full btn-secondary !bg-white/10 !text-white !border-white/20 hover:!bg-white/20 flex items-center justify-center gap-2 !h-12 text-xs sm:text-sm font-bold"
          >
            <svg class="w-4 h-4 text-[#1eaa52]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="truncate">Call Sondagar Mandeepbhai: {STORE_INFO.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
