---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import WholesaleBanner from '../components/WholesaleBanner.astro';
import StoreStory from '../components/StoreStory.astro';
import LocationSection from '../components/LocationSection.astro';
import Footer from '../components/Footer.astro';
import { STORE_INFO } from '../data/store';
---

<Layout
  title={`${STORE_INFO.name} | Shatrunjay Teerth Yatra & Wholesale Store Palitana`}
  description="Official catalog of Krishna General Store & Upkaran Bhandar at Palitana Taleti. Owner: Sondagar Mandeepbhai (8141180807). Shatrunjay Teerth Yatra essentials, Jain puja items, almonds, rice, dry fruits, walking sticks, and wholesale supply for shopkeepers."
>
  <Navbar />
  <main>
    <Hero />
    <!-- Catalog of 150 Items placed before Wholesale Banner per user request -->
    <Catalog />
    <!-- Special Wholesale Trade Rates placed after Items per user request -->
    <WholesaleBanner />
    <StoreStory />
    <LocationSection />
  </main>
  <Footer />
</Layout>
