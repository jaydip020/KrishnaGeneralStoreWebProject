---
import '../styles/global.css';
import { STORE_INFO } from '../data/store';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${STORE_INFO.name} | Palitana Taleti - Yatra & Wholesale Store`,
  description = "Official catalog of Krishna General Store & Upkaran Bhandar at Palitana Taleti. Shatrunjaya Yatra essentials, Jain puja items, dry fruits, cold drinks, white cloths, and wholesale supply for shopkeepers.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://krishnageneralstorepalitana.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/shop-front.jpg" />

    <!-- Google Fonts: Bebas Neue (Editorial Display Campaign) & Inter (UI Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-[#111111] antialiased selection:bg-[#111111] selection:text-white">
    <slot />
  </body>
</html>
